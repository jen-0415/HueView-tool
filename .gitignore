# =========================
# Python virtual environment
# =========================
.venv*/
env/
venv/

# =========================
# Python cache
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# Dataset
# =========================

# Ignore everything under data by default
data/*

# Keep the processed folder visible to Git
!data/processed/

# Ignore everything inside processed by default
data/processed/*

# The 224x224 images stay local / on Google Drive
data/processed/images/

# Keep small processed metadata files in Git
!data/processed/*.csv
!data/processed/*.json
!data/processed/*.bak

# =========================
# Trained model files
# =========================
models/
*.h5
*.keras

# =========================
# Training/runtime output
# =========================
logs/
*.log

# =========================
# Jupyter
# =========================
.ipynb_checkpoints/

# =========================
# VS Code local settings
# =========================
.vscode/

# =========================
# OS clutter
# =========================
.DS_Store
Thumbs.db